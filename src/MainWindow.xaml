<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Air5 Control" Width="960" Height="730" MinWidth="850" MinHeight="690" WindowStartupLocation="CenterScreen" Background="#0B1019" Foreground="#EDF3FA" FontFamily="Segoe UI" WindowStyle="None" ResizeMode="CanResizeWithGrip">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#94A3B8"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#1B293A"/><Setter Property="Foreground" Value="#DFEAF6"/><Setter Property="BorderBrush" Value="#304156"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,11"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.6"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#131D2A"/><Setter Property="BorderBrush" Value="#253245"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="22"/></Style>
 </Window.Resources>
 <Border BorderBrush="#2B394C" BorderThickness="1">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid x:Name="TitleDrag" Background="#101824">
   <TextBlock Text="◉   AIR5 CONTROL" Foreground="#8CA2BC" FontSize="10" FontWeight="SemiBold" Margin="20,0" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Minimize" ToolTip="Sistem tepsisine küçült" Content="−" BorderThickness="0" Background="Transparent" Padding="17,8"/><Button x:Name="Close" ToolTip="Sistem tepsisine gizle" Content="✕" BorderThickness="0" Background="Transparent" Padding="17,8"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="32,24,32,22">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="164"/><RowDefinition Height="20"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="148"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="SOUNDPEATS" FontSize="10" Foreground="#6ED8EE" FontWeight="Bold"/><TextBlock Text="Air5 Pro" FontSize="32" FontWeight="SemiBold" Margin="0,2,0,4"/><TextBlock Text="Sesinin kontrolü, hemen yanında." Foreground="{StaticResource Muted}" FontSize="13"/><TextBlock x:Name="AudioText" Text="Ses çıkışı: bekleniyor" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0"/></StackPanel>
    <Border Grid.Column="1" Background="#162432" CornerRadius="12" Padding="15,10" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#8492A6" Margin="0,0,9,0"/><TextBlock x:Name="ConnectionText" Text="Bağlantı bekleniyor" FontSize="12"/></StackPanel></Border>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="SOL KULAKLIK" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock Text="L" HorizontalAlignment="Right" Foreground="#6ED8EE" FontSize="20" FontWeight="Light"/></Grid><TextBlock x:Name="LeftValue" Grid.Row="1" Text="—" FontSize="37" FontWeight="SemiBold" Margin="0,6,0,13"/><ProgressBar x:Name="LeftBar" Grid.Row="2" Height="4" Maximum="100" Value="0" Background="#273649" Foreground="#6ED8EE" BorderThickness="0"/></Grid></Border>
    <Border Grid.Column="2" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="SAĞ KULAKLIK" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock Text="R" HorizontalAlignment="Right" Foreground="#6ED8EE" FontSize="20" FontWeight="Light"/></Grid><TextBlock x:Name="RightValue" Grid.Row="1" Text="—" FontSize="37" FontWeight="SemiBold" Margin="0,6,0,13"/><ProgressBar x:Name="RightBar" Grid.Row="2" Height="4" Maximum="100" Value="0" Background="#273649" Foreground="#6ED8EE" BorderThickness="0"/></Grid></Border>
    <Border Grid.Column="4" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="ŞARJ KUTUSU" FontSize="10" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE83F;" HorizontalAlignment="Right" Foreground="#E6C38D" FontSize="23"/></Grid><TextBlock x:Name="CaseValue" Grid.Row="1" Text="—" FontSize="37" FontWeight="SemiBold" Margin="0,6,0,13"/><ProgressBar x:Name="CaseBar" Grid.Row="2" Height="4" Maximum="100" Value="0" Background="#273649" Foreground="#E6C38D" BorderThickness="0"/></Grid></Border>
   </Grid>
   <Grid Grid.Row="4"><TextBlock Text="Dinleme modu" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="ModeText" Text="Durum okunmadı" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#6ED8EE" FontSize="12"/></Grid>
   <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button x:Name="AncButton" Background="#131D2A" BorderBrush="#253245" HorizontalContentAlignment="Stretch"><StackPanel><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="25" Margin="0,0,0,12" HorizontalAlignment="Center"/><TextBlock Text="Gürültü engelleme" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="Dış sesleri azalt" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="TransparencyButton" Grid.Column="2" Background="#131D2A" BorderBrush="#253245"><StackPanel><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="25" Margin="0,0,0,12" HorizontalAlignment="Center"/><TextBlock Text="Şeffaflık" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="Çevreni duymaya devam et" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
    <Button x:Name="NormalButton" Grid.Column="4" Background="#131D2A" BorderBrush="#253245"><StackPanel><TextBlock Text="&#xE7F6;" FontFamily="Segoe MDL2 Assets" FontSize="25" Margin="0,0,0,12" HorizontalAlignment="Center"/><TextBlock Text="Normal" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center"/><TextBlock Text="Gürültü kontrolü kapalı" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0" HorizontalAlignment="Center"/></StackPanel></Button>
   </Grid>
   <Grid Grid.Row="7" Margin="0,12,0,0" VerticalAlignment="Top"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Oyun modu" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="GameText" Text="Durum okunamadı" FontSize="11" Foreground="#94A3B8" Margin="0,3,0,0"/></StackPanel><Button x:Name="GameButton" Grid.Column="1" Content="Oyun modunu aç" Padding="16,9"/></Grid>
   <Grid Grid.Row="8" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="Message" Text="Kulaklığın açık ve Windows'a bağlı olduğundan emin ol." FontSize="12" Foreground="#B7C4D7" TextWrapping="Wrap" Margin="0,0,20,7"/><TextBlock x:Name="Detail" Text="Pil bilgileri kulaklığın bildirdiği son değerlerdir." FontSize="10" Foreground="#71839C" TextWrapping="Wrap" Margin="0,0,15,0"/><TextBlock x:Name="VersionText" Text="AIR5 CONTROL  /  1.6" Foreground="#526780" FontSize="9" Margin="0,9,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="↻  Yenile" Margin="0,0,8,0"/><Button x:Name="ConnectButton" Content="Bağlan" Background="#6ED8EE" Foreground="#081923" BorderBrush="#6ED8EE" FontWeight="SemiBold"/></StackPanel></Grid>
  </Grid>
 </Grid>
 </Border>
</Window>
